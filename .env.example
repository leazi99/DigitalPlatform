# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill it in. `.env` is gitignored.
#
# Anything prefixed VITE_ is readable in the browser — Vite inlines it into the
# bundle. Everything else is server-only. Never move a secret above that line.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────

PORT=4000

# Signs admin session tokens. REQUIRED — the server refuses to start without
# it, rather than generating one and logging every admin out on each restart.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long an admin stays signed in.
SESSION_HOURS=12

# The first admin account, created on the first run only. REQUIRED, at least 8
# characters. Changing these later does nothing — change the password from
# inside the admin panel instead.
ADMIN_EMAIL=admin@digitalworld.local
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Where the SQLite file lives, relative to the project root. Optional.
# DB_FILE=server/data.db

# Browser origins allowed to call the API. Needed in development because Vite
# serves the site on a different port. In production the API and the site are
# the same origin and this is unused.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Browser ─────────────────────────────────────────────────────────────────

# Where the site and the admin panel look for the API. In development this
# points at the API port. In production, leave it empty: the same process
# serves both, so a relative /api is correct.
VITE_API_URL=http://localhost:4000

# Optional. Formspree endpoints, if you want an email copy of a submission as
# well as the database row. Leave blank to store submissions only.
VITE_FORMSPREE_AGENCY=
VITE_FORMSPREE_INSTITUTE=
