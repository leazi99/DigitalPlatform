# Copy this file to `.env` and fill in your two Formspree form IDs.
# Create the forms at https://formspree.io — one per sector, so agency
# enquiries and course enrolments land in separate inboxes.
#
# `.env` is gitignored. `.env.example` is not — keep the real IDs out of it.

VITE_FORMSPREE_AGENCY=
VITE_FORMSPREE_INSTITUTE=
